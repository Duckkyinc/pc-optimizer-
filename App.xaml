<Application x:Class="Overdrive.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- ============ palette ============ -->
        <Color x:Key="BgColor">#0A0C11</Color>
        <Color x:Key="AccentAColor">#00E5FF</Color>
        <Color x:Key="AccentBColor">#8B5CF6</Color>
        <SolidColorBrush x:Key="Bg" Color="#0A0C11"/>
        <SolidColorBrush x:Key="Side" Color="#0E1117"/>
        <SolidColorBrush x:Key="Card" Color="#131721"/>
        <SolidColorBrush x:Key="CardHover" Color="#181D29"/>
        <SolidColorBrush x:Key="Line" Color="#222838"/>
        <SolidColorBrush x:Key="Text" Color="#EEF1F7"/>
        <SolidColorBrush x:Key="Sub" Color="#8D96AB"/>
        <SolidColorBrush x:Key="Dim" Color="#5A6378"/>
        <SolidColorBrush x:Key="Accent" Color="#00E5FF"/>
        <SolidColorBrush x:Key="Purple" Color="#8B5CF6"/>
        <SolidColorBrush x:Key="Good" Color="#2EE59D"/>
        <SolidColorBrush x:Key="Warn" Color="#FFB547"/>
        <SolidColorBrush x:Key="Bad" Color="#FF5470"/>
        <SolidColorBrush x:Key="NvGreen" Color="#76B900"/>
        <SolidColorBrush x:Key="AmdRed" Color="#ED1C24"/>
        <LinearGradientBrush x:Key="AccentGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#00E5FF" Offset="0"/>
            <GradientStop Color="#8B5CF6" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="HeroGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#1A1035" Offset="0"/>
            <GradientStop Color="#0B2233" Offset="1"/>
        </LinearGradientBrush>

        <FontFamily x:Key="Ui">Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="UiDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>

        <!-- ============ text ============ -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
        </Style>
        <Style x:Key="H1" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontFamily" Value="{StaticResource UiDisplay}"/>
        </Style>
        <Style x:Key="H2" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
        </Style>
        <Style x:Key="SubText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource Sub}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
            <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
        </Style>

        <!-- ============ card ============ -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- ============ buttons ============ -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Foreground" Value="#06121A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform"><Setter.Value><TransformGroup><ScaleTransform/><TranslateTransform/></TransformGroup></Setter.Value></Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- soft glow underneath (hover) -->
                            <Border x:Name="glow" CornerRadius="12" Margin="2,4,2,-2" Background="{StaticResource AccentGrad}" Opacity="0"/>
                            <Border x:Name="b" CornerRadius="11" Background="{StaticResource AccentGrad}" BorderBrush="#40FFFFFF" BorderThickness="1"/>
                            <!-- glossy top highlight -->
                            <Border x:Name="shine" CornerRadius="11,11,0,0" VerticalAlignment="Top" Height="18" Margin="1,1,1,0" Opacity="0.55">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#55FFFFFF" Offset="0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0:0:0.15"/>
                                    <DoubleAnimation Storyboard.TargetName="shine" Storyboard.TargetProperty="Opacity" To="0.9" Duration="0:0:0.15"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" To="-1" Duration="0:0:0.15"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                                    <DoubleAnimation Storyboard.TargetName="shine" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.2"/>
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" To="0" Duration="0:0:0.2"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform"><Setter.Value><TransformGroup><ScaleTransform ScaleX="0.97" ScaleY="0.97"/><TranslateTransform/></TransformGroup></Setter.Value></Setter>
                                <Setter TargetName="shine" Property="Opacity" Value="0.3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform"><Setter.Value><ScaleTransform/></Setter.Value></Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="11" BorderThickness="1">
                            <Border.Background><SolidColorBrush x:Name="bg" Color="#1A1F2C"/></Border.Background>
                            <Border.BorderBrush><SolidColorBrush x:Name="bd" Color="#2A3142"/></Border.BorderBrush>
                            <Grid>
                                <Border CornerRadius="10,10,0,0" VerticalAlignment="Top" Height="14" Opacity="0.6">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#14FFFFFF" Offset="0"/>
                                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <ColorAnimation Storyboard.TargetName="bg" Storyboard.TargetProperty="Color" To="#232A3B" Duration="0:0:0.15"/>
                                    <ColorAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="Color" To="#00B8D4" Duration="0:0:0.15"/>
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <ColorAnimation Storyboard.TargetName="bg" Storyboard.TargetProperty="Color" To="#1A1F2C" Duration="0:0:0.2"/>
                                    <ColorAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="Color" To="#2A3142" Duration="0:0:0.2"/>
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Setter.Value></Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Foreground" Value="{StaticResource Bad}"/>
        </Style>
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Sub}"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#1E2330"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource ChromeButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#C42B1C"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuRow" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="8" Background="Transparent" Padding="10,8" Margin="0,1">
                            <Grid>
                                <Border x:Name="bar" Width="3" CornerRadius="2" HorizontalAlignment="Left" Margin="-10,2,0,2" Background="{StaticResource AccentGrad}" Visibility="Collapsed"/>
                                <ContentPresenter HorizontalAlignment="Stretch"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#222839"/></Trigger>
                            <Trigger Property="Tag" Value="sel">
                                <Setter TargetName="b" Property="Background" Value="#1C2433"/>
                                <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Seg" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{StaticResource Sub}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="8" Background="Transparent" Padding="10,6">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#222839"/></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="Background" Value="#2A3346"/><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ sidebar nav ============ -->
        <Style x:Key="NavGroup" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Dim}"/>
            <Setter Property="Margin" Value="26,14,0,4"/>
        </Style>
        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Sub}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="10,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="nav"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="9" Background="Transparent" Padding="14,8">
                            <Grid>
                                <Border x:Name="bar" Width="3" CornerRadius="2" HorizontalAlignment="Left" Margin="-14,2,0,2" Background="{StaticResource AccentGrad}" Visibility="Collapsed"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="ic" Text="{TemplateBinding Tag}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#151A24"/><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#18202E"/>
                                <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                <Setter TargetName="ic" Property="Foreground" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ toggle switch ============ -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Border x:Name="track" Width="50" Height="26" CornerRadius="13" Background="#232937" BorderBrush="#323A4D" BorderThickness="1"/>
                            <Ellipse x:Name="knob" Width="18" Height="18" Fill="#8D96AB" HorizontalAlignment="Left" Margin="4,0,0,0">
                                <Ellipse.RenderTransform><TranslateTransform x:Name="tt" X="0"/></Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{StaticResource AccentGrad}"/>
                                <Setter TargetName="track" Property="BorderBrush" Value="Transparent"/>
                                <Setter TargetName="knob" Property="Fill" Value="White"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="tt" Storyboard.TargetProperty="X" To="24" Duration="0:0:0.15"/></Storyboard></BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="tt" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.15"/></Storyboard></BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Check" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="box" Width="20" Height="20" CornerRadius="6" Background="#1A1F2C" BorderBrush="#3A4358" BorderThickness="1.5" VerticalAlignment="Top" Margin="0,1,10,0">
                                <TextBlock x:Name="mark" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" Foreground="#06121A" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{StaticResource AccentGrad}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="Transparent"/>
                                <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ slim scrollbar ============ -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="4" Background="#2A3142" Margin="1,0"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="0"/>
                    <Setter Property="MinHeight" Value="0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============ progress bar ============ -->
        <Style x:Key="Meter" TargetType="ProgressBar">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="3" Background="#222838"/>
                            <Border x:Name="PART_Indicator" CornerRadius="3" Background="{StaticResource AccentGrad}" HorizontalAlignment="Left"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ text input ============ -->
        <Style x:Key="Input" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Purple}"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="b" CornerRadius="10" Background="#0F131B" BorderBrush="{StaticResource Line}" BorderThickness="1.5" Padding="12,8">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#00E5FF"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#3A4358"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchInput" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource Purple}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="b" CornerRadius="11" Background="#141924" BorderBrush="#2A3142" BorderThickness="1" Padding="36,0,12,0">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#3A4358"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#00E5FF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ chip (pick one) ============ -->
        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource Sub}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="{StaticResource Ui}"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="9" Background="#1A1F2C" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#3A4358"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource AccentGrad}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#06121A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolVis"/>


        <!-- ============ compact tweak tile (grid view) ============ -->
        <DataTemplate x:Key="TweakTile">
            <Border x:Name="card" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Margin="0,0,10,10" Padding="0" Height="86" ToolTipService.InitialShowDelay="350" ToolTipService.ShowDuration="30000">
                <Border.ToolTip>
                    <ToolTip Background="#161B26" BorderBrush="#2A3142" Foreground="#EEF1F7" Padding="12,10" MaxWidth="360" HasDropShadow="True">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" Margin="0,0,0,4" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12" Foreground="#A4ADC0" LineHeight="18"/>
                            <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" FontSize="12" Foreground="#E8C38A" Margin="0,8,0,0" Visibility="{Binding HasWarning, Converter={StaticResource BoolVis}}"/>
                        </StackPanel>
                    </ToolTip>
                </Border.ToolTip>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- impact color strip -->
                    <Border x:Name="strip" CornerRadius="12,0,0,12" Background="#3A4358"/>
                    <StackPanel Grid.Column="1" Margin="14,10,10,10" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" LineHeight="18"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock x:Name="impactText" Text="{Binding ImpactLabel}" FontSize="9.5" FontWeight="Bold" Foreground="#8D96AB" VerticalAlignment="Center"/>
                            <TextBlock Text="  ·  RESTART" FontSize="9.5" FontWeight="Bold" Foreground="#FFB547" VerticalAlignment="Center" Visibility="{Binding NeedsReboot, Converter={StaticResource BoolVis}}"/>
                            <TextBlock Text="  ·  ADVANCED" FontSize="9.5" FontWeight="Bold" Foreground="#FF5470" VerticalAlignment="Center" Visibility="{Binding Advanced, Converter={StaticResource BoolVis}}"/>
                            <TextBlock Text="  ·  ★" FontSize="10" Foreground="#2EE59D" VerticalAlignment="Center" ToolTip="Recommended" Visibility="{Binding Recommended, Converter={StaticResource BoolVis}}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,14,0">
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding IsOn, Mode=TwoWay}" IsEnabled="{Binding CanToggle}"/>
                        <TextBlock x:Name="na" Text="n/a" FontSize="9.5" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" Margin="0,4,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding ImpactKey}" Value="High"><Setter TargetName="strip" Property="Background" Value="#2EE59D"/><Setter TargetName="impactText" Property="Foreground" Value="#2EE59D"/></DataTrigger>
                <DataTrigger Binding="{Binding ImpactKey}" Value="Medium"><Setter TargetName="strip" Property="Background" Value="#00E5FF"/><Setter TargetName="impactText" Property="Foreground" Value="#00E5FF"/></DataTrigger>
                <DataTrigger Binding="{Binding ImpactKey}" Value="Situational"><Setter TargetName="strip" Property="Background" Value="#8B5CF6"/><Setter TargetName="impactText" Property="Foreground" Value="#B69CFF"/></DataTrigger>
                <DataTrigger Binding="{Binding ImpactKey}" Value="Quality"><Setter TargetName="strip" Property="Background" Value="#FF8AD8"/><Setter TargetName="impactText" Property="Foreground" Value="#FF8AD8"/></DataTrigger>
                <DataTrigger Binding="{Binding IsOn}" Value="True"><Setter TargetName="card" Property="BorderBrush" Value="#1F4A5A"/><Setter TargetName="card" Property="Background" Value="#14202B"/></DataTrigger>
                <DataTrigger Binding="{Binding Available}" Value="False"><Setter TargetName="na" Property="Visibility" Value="Visible"/><Setter TargetName="card" Property="Opacity" Value="0.5"/></DataTrigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="card" Property="BorderBrush" Value="#3A4358"/></Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ============ tweak card (used on every page) ============ -->
        <DataTemplate x:Key="TweakCard">
            <Border x:Name="card" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,24,0">
                        <WrapPanel Margin="0,0,0,6">
                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <Border x:Name="impact" CornerRadius="5" Padding="7,2" Margin="0,0,6,0" Background="#1C2433" VerticalAlignment="Center">
                                <TextBlock x:Name="impactText" Text="{Binding ImpactLabel}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                            </Border>
                            <Border CornerRadius="5" Padding="7,2" Margin="0,0,6,0" Background="#1F2A1F" VerticalAlignment="Center"
                                    Visibility="{Binding Recommended, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="RECOMMENDED" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Good}"/>
                            </Border>
                            <Border CornerRadius="5" Padding="7,2" Margin="0,0,6,0" Background="#2A2418" VerticalAlignment="Center"
                                    Visibility="{Binding NeedsReboot, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="RESTART" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Warn}"/>
                            </Border>
                            <Border CornerRadius="5" Padding="7,2" Margin="0,0,6,0" Background="#2D1820" VerticalAlignment="Center"
                                    Visibility="{Binding Advanced, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="ADVANCED" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Bad}"/>
                            </Border>
                        </WrapPanel>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource SubText}" LineHeight="19"/>
                        <Border Margin="0,10,0,0" CornerRadius="8" Background="#1D1A14" Padding="10,7"
                                Visibility="{Binding HasWarning, Converter={StaticResource BoolVis}}">
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#E8C38A">
                                <Run Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                                <Run Text=" "/>
                                <Run Text="{Binding Warning, Mode=OneWay}"/>
                            </TextBlock>
                        </Border>
                        <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource Dim}" Margin="0,8,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding IsOn, Mode=TwoWay}" IsEnabled="{Binding CanToggle}"/>
                        <TextBlock Text="Not available" FontSize="10" Foreground="{StaticResource Dim}" HorizontalAlignment="Center" Margin="0,6,0,0" x:Name="na" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding ImpactKey}" Value="High">
                    <Setter TargetName="impact" Property="Background" Value="#14302A"/>
                    <Setter TargetName="impactText" Property="Foreground" Value="#2EE59D"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ImpactKey}" Value="Medium">
                    <Setter TargetName="impact" Property="Background" Value="#10283A"/>
                    <Setter TargetName="impactText" Property="Foreground" Value="#00E5FF"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ImpactKey}" Value="Low">
                    <Setter TargetName="impact" Property="Background" Value="#1E2230"/>
                    <Setter TargetName="impactText" Property="Foreground" Value="#8D96AB"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ImpactKey}" Value="Situational">
                    <Setter TargetName="impact" Property="Background" Value="#241C36"/>
                    <Setter TargetName="impactText" Property="Foreground" Value="#B69CFF"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ImpactKey}" Value="Quality">
                    <Setter TargetName="impact" Property="Background" Value="#2A1E2E"/>
                    <Setter TargetName="impactText" Property="Foreground" Value="#FF8AD8"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Available}" Value="False">
                    <Setter TargetName="na" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="card" Property="Opacity" Value="0.55"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOn}" Value="True">
                    <Setter TargetName="card" Property="BorderBrush" Value="#1F4A5A"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

    </Application.Resources>
</Application>
